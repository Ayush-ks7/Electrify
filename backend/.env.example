APP_ENV=development
LOG_LEVEL=INFO
# Omit DATABASE_URL to use backend/electrify.db regardless of working directory.
# DATABASE_URL=sqlite:///./electrify.db
DATABASE_AUTO_CREATE=true
# Optional absolute paths; defaults use the package under ai_ml/.
# AI_ML_MODEL_PATH=B:/Codeutsava X.0/Electrify/ai_ml/Electrify_AI_ML_Final/models/electrify_final_model.joblib
# AI_ML_REFERENCE_MEDIANS_PATH=B:/Codeutsava X.0/Electrify/ai_ml/Electrify_AI_ML_Final/artifacts/feature_reference_medians_train_only.json
DEFAULT_THRESHOLD=0.2010437721624017
EXPLANATION_TOP_K=3
# Set a nonempty shared API key to protect every /api/v1 route; /health stays public.
# API_KEY=replace-with-a-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_CONSUMERS_PER_REQUEST=100
